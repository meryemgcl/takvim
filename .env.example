# =============================================================================
# INOVASYON ETKINLIK AJANDASI -- Ortam Degiskenleri
# =============================================================================
# Bu dosyayi kopyalayin: cp .env.example .env
# .env dosyasini asla Git'e commit etmeyin!
# =============================================================================

# --- ZORUNLU ---

# Google Gemini AI API Anahtari
# Edinme: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Uygulamanin host URL
APP_URL="http://localhost:3000"

# --- FIREBASE AUTHENTICATION ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- GOOGLE OAUTH 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-POSTA (SABAH BRIFINGI ve ROLLOVER BILDIRIMLERI) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Takvim Asistani noreply@example.com"

# Varsayilan alici e-posta
RECIPIENT_EMAIL=

# --- NOTION ENTEGRASYONU (OPSIYONEL) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- UYGULAMA AYARLARI ---
PORT=3000
NODE_ENV=development